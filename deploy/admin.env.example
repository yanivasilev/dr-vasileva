# Copy to /etc/drvasileva/admin.env and fill in.  chmod 600 /etc/drvasileva/admin.env

# The editor's address. Form posts from any other address are refused.
# While testing on the test domain use https://drvasileva-admin.vasilevdigital.com
ADMIN_ORIGIN=https://admin.drvasileva.co.uk

# Every sign-in, and every lock after 5 wrong tries, is emailed here
ADMIN_ALERT_TO=contact@drvasileva.co.uk

# Your mailcow server, the same mailbox as the contact form (see contact.env.example)
SMTP_HOST=mail.example.com
SMTP_PORT=465
SMTP_SECURITY=ssl
SMTP_USER=website@drvasileva.co.uk
SMTP_PASSWORD=change-me
MAIL_FROM=Website <website@drvasileva.co.uk>

# Where the published articles go (nginx serves them, see step 9). The default is fine.
# BLOG_OUT_DIR=/var/www/drvasileva-blog

LISTEN_HOST=127.0.0.1
LISTEN_PORT=8788
