# Copy to /etc/drvasileva/contact.env and fill in.  chmod 600 /etc/drvasileva/contact.env

# Cloudflare Turnstile secret key (dashboard → Turnstile → your widget).
# The site key is already built into the website; paste the matching secret key here.
# Keep it only in this file on the server, never in the repository.
TURNSTILE_SECRET_KEY=paste-the-secret-key-here

# Your mailcow server. Create a mailbox for the website first, e.g. website@drvasileva.co.uk
SMTP_HOST=mail.example.com
SMTP_PORT=465
SMTP_SECURITY=ssl
SMTP_USER=website@drvasileva.co.uk
SMTP_PASSWORD=change-me

MAIL_FROM=Website <website@drvasileva.co.uk>
MAIL_TO_EN=contact@drvasileva.co.uk
MAIL_TO_BG=contact@drvasileva.bg

LISTEN_HOST=127.0.0.1
LISTEN_PORT=8787
